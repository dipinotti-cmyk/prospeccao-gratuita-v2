{
  "crons": [
    {
      "path": "/api/cron-encerrar-frios",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "pages/api/run.js": {
      "maxDuration": 60
    },
    "pages/api/apify-webhook.js": {
      "maxDuration": 60
    },
    "pages/api/leads/regenerate-all.js": {
      "maxDuration": 60
    },
    "pages/api/runs.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
